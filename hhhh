PP_TERM_RE = re.compile(r"\[\s*\(in the case of a Term Rate Loan\)\s*\]\s*", re.I)
PP_COMP_RE = re.compile(r"\[\s*,\s*and in the case of a Compounded Rate Loan.*?in any year\s*,\s*\]", re.I)
PP_MULT_RE = re.compile(r"\s*\[\s*provided that such prepayment must be in multiples of.*?the relevant Facility", re.I)

def process_prepayment(doc, term, comp, mult, mini):
    # 4(c) : options Term Rate / Compounded Rate + multiples / minimum
    mult, mini = mult.strip(), mini.strip()
    amt = (f"in multiples of {mult}" + (f" (or at least {mini})" if mini else "")) if mult else (f"at least {mini}" if mini else "")
    for p in _iter_all_paragraphs(doc):
        if "may prepay outstanding funded drawings" not in p.text.lower(): continue
        regex_sub_in_paragraph(p, PP_TERM_RE, "(in the case of a Term Rate Loan) " if term else "")
        regex_sub_in_paragraph(p, PP_COMP_RE, ", and in the case of a Compounded Rate Loan, not more than 3 voluntary prepayments in aggregate being made in any year," if comp else "")
        regex_sub_in_paragraph(p, PP_MULT_RE, f" provided that such prepayment must be {amt} or (if less) the balance outstanding under the relevant Facility" if amt else "")


